# Managed by chezmoi. Machine identity comes from its local configuration.
[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
[user]
    name = {{ .gitName | quote }}
    email = {{ .gitEmail | quote }}
[core]
    editor = nvim
    autocrlf = input
    excludesFile = {{ joinPath .chezmoi.homeDir ".config/git/ignore" | quote }}
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
[commit]
    verbose = true
{{ if .gitSigningKey }}
    gpgsign = true
[user]
    signingkey = {{ .gitSigningKey | quote }}
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = {{ joinPath .chezmoi.homeDir ".config/git/allowed_signers" | quote }}
{{ end }}
[column]
    ui = auto
[branch]
    sort = -committerdate
[tag]
    sort = -version:refname
[rerere]
    enabled = true
    autoupdate = true
