config/coc/memos.json
.DS_Store

# Never commit key material. secret-key.asc — an unencrypted OpenPGP private
# key — lived here from 2022 until it was removed; do not let it happen twice.
*.asc
*.gpg
*.key
*.pem
id_*
!id_*.pub
.zshrc-secrets*
.secrets

# herdr writes runtime state into ~/.config/herdr, which is a stow symlink
# into this repo, so its logs and session state land here uninvited.
herdr/.config/herdr/*.log
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/.plugins.lock
